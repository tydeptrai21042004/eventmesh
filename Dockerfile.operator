# Builds all workspace runtime packages before starting the reference operator.
FROM node:22.16.0-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY apps/operator/package.json apps/operator/package.json
COPY apps/demo/package.json apps/demo/package.json
COPY apps/verifier/package.json apps/verifier/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/fiber/package.json packages/fiber/package.json
COPY packages/ckb/package.json packages/ckb/package.json
COPY packages/adapter-sdk/package.json packages/adapter-sdk/package.json
RUN npm install --no-audit --no-fund
COPY packages ./packages
RUN npm run build:runtime
COPY apps/operator ./apps/operator

FROM node:22.16.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production DATA_DIR=/data
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/operator ./apps/operator
COPY --from=build /app/package.json ./package.json
COPY scripts/operator-entrypoint.sh /usr/local/bin/operator-entrypoint.sh
RUN mkdir -p /data && chown -R node:node /data
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 4000) + '/health').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"
ENTRYPOINT ["/bin/sh", "/usr/local/bin/operator-entrypoint.sh"]
CMD ["node", "--import", "tsx", "apps/operator/src/index.ts"]
