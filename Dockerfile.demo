FROM node:22.16.0-bookworm-slim AS build
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY apps/demo/package.json apps/demo/package.json
RUN npm install
COPY apps/demo ./apps/demo
ARG VITE_OPERATOR_A_URL=http://localhost:4001
ARG VITE_OPERATOR_B_URL=http://localhost:4002
ENV VITE_OPERATOR_A_URL=$VITE_OPERATOR_A_URL VITE_OPERATOR_B_URL=$VITE_OPERATOR_B_URL
RUN npm --workspace @eventmesh/demo run build
FROM nginx:1.27-alpine
COPY --from=build /app/apps/demo/dist /usr/share/nginx/html
EXPOSE 80
